
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B-TRACK 🚌"
                    android:textColor="#172B4D"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="College Bus Tracker"
                    android:textColor="#6698CC"
                    android:textSize="13sp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvNotification"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="🔔"
                android:textSize="24sp"/>

        </LinearLayout>

        <!-- Welcome Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Hello, Student! 👋"
            android:textColor="#172B4D"
            android:textSize="27sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Where are you going today?"
            android:textColor="#6698CC"
            android:textSize="16sp"/>

        <!-- Next Bus Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#172B4D"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR NEXT BUS"
                android:textColor="#F2D88F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="🚌"
                android:textSize="42sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="No bus selected"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Choose a bus route to view timings"
                android:textColor="#DCE8F5"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- Explore Routes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Explore Routes"
            android:textColor="#172B4D"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Find your college bus route easily."
            android:textColor="#777777"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnExploreRoutes"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#F08C21"
            android:text="EXPLORE BUS ROUTES"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"/>

        <!-- Quick Access -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Quick Access"
            android:textColor="#172B4D"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTimings"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#6698CC"
                android:text="Timings"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnFavorites"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#E36888"
                android:text="Favorites"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="15dp"
            android:text="Your Journey, Our Priority ❤️"
            android:textColor="#6698CC"
            android:textSize="13sp"/>

    </LinearLayout>

</ScrollView>
